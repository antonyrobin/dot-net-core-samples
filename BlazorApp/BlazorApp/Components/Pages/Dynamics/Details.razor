@page "/dynamics/details/{Id}"
@using BlazorApp.Services.Interfaces
@inject IFormSubmissionService SubmissionService
@inject IFormDefinitionService FormDefService

<PageTitle>Candidate Details</PageTitle>

<div class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-4xl mx-auto px-4">
        <a href="/dynamics/dashboard" class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-700 mb-6">
            ← Back to Dashboard
        </a>

        <div class="bg-white rounded-3xl shadow-2xl p-10">
            <div class="main-wrapper">
                <div class="form-card">
                    <div class="form-header">
                        <h2>
                            Candidate Details
                            <a href="/Dynamics/Dashboard" class="browse-link">Back</a>
                        </h2>
                    </div>

                    @if (Submission?.FileData.ContainsKey("profilePic") == true)
                    {
                        <div style="text-align:center; margin-bottom:20px;">
                            <img src="/files/@Submission.FileData["profilePic"]"
                                 style="width:120px; height:120px; border-radius:50%; object-fit:cover; border:3px solid #eee;" />
                        </div>
                    }

                    <div class="submitted-data-table">
                        @foreach (var control in Controls.Where(c => c.Type != "file" && c.Type != "image"))
                        {
                            <div style="margin-bottom:15px;">
                                <strong>@control.Label</strong>
                                <div style="font-size:16px;">
                                    @(Submission?.TextData.GetValueOrDefault(control.Name)?.ToString() ?? "")
                                </div>
                            </div>
                        }
                    </div>

                    <h3>Attachments</h3>
                    @foreach (var file in Submission?.FileData ?? new Dictionary<string, string>())
                    {
                        if (file.Key != "profilePic")
                        {
                            <div style="margin-bottom:10px;">
                                <span>@file.Key :</span>
                                <a href="/files/@file.Value" target="_blank" class="browse-link">Download File</a>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private FormSubmission? Submission;
    private List<FormControl> Controls = new();

    protected override async Task OnInitializedAsync()
    {
        Submission = await SubmissionService.GetByIdAsync(Id);
        Controls = FormDefService.GetFormControls();
    }
}